{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkLog",
  "version": "0.3.0",
  "identifier": "local.worklog.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "WorkLog",
        "width": 1320,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "licenses/WorkLog-LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES.txt",
      "../third-party/": "licenses/third-party/"
    },
    "targets": "all",
    "shortDescription": "Project notes and time, kept local",
    "category": "Productivity",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/legacy.desktop.hbs",
        "files": {
          "/usr/share/applications/local.worklog.desktop.desktop": "linux/local.worklog.desktop.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
